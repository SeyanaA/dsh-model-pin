{
  "name": "dsh-model-pin",
  "version": "0.2.0",
  "description": "Pins the default conversation model and provider for newly created Sessions while the built-in per-Session model picker keeps working, and reminds you when configured providers add new models.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SeyanaA/dsh-model-pin.git"
  },
  "homepage": "https://github.com/SeyanaA/dsh-model-pin#readme",
  "bugs": {
    "url": "https://github.com/SeyanaA/dsh-model-pin/issues"
  },
  "author": "SeyanaA",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "model",
    "default-model",
    "model-pin"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "src/",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "docs/"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.3 <0.3.0"
  },
  "license": "MIT"
}
